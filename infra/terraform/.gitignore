# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local variable overrides — contain secrets
*.tfvars
!terraform.tfvars.example

# Plugin cache and lock files
.terraform/
.terraform.lock.hcl

# Terraform plan output — contains all variable values in plaintext,
# including sensitive ones (sensitive = true only suppresses terminal output).
tfplan
*.tfplan

# Crash logs
crash.log
crash.*.log

# Override files (local dev only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
