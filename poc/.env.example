# Required: your API key
OPENAI_API_KEY=your_api_key_here

# Optional: override the base URL (e.g. to use Gemini or any OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional: model name (default: gpt-4o-mini)
MODEL=gpt-4o-mini

# Fixed PoC user identity (UUID). Change to any valid UUID v4.
POC_USER_ID=00000000-0000-0000-0000-000000000001

# PostgreSQL connection — used by export_pg_to_sqlite.py only.
# Never commit real credentials. Set PG_PASSWORD at runtime:
#   export PG_PASSWORD=secret && uv run python export_pg_to_sqlite.py
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_DBNAME=receipt_pal
# PG_PASSWORD=  ← set in your shell, not here
